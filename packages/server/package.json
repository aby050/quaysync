{
  "name": "@quaysync/server",
  "version": "0.1.0",
  "description": "Reference sync server for QuaySync: Fetch-API handler with memory and Cloudflare D1 backends.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@quaysync/core": "0.1.0"
  },
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "tsc -b"
  },
  "author": "Abhay Bundela",
  "keywords": [
    "sync",
    "cloudflare",
    "d1",
    "workers",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aby050/quaysync.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/aby050/quaysync#readme",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}