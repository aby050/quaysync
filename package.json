{
  "name": "quaysync-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w @quaysync/core -w @quaysync/server -w @quaysync/react",
    "test": "vitest run",
    "typecheck": "tsc -b packages/core packages/server packages/react",
    "example": "npm run build && npm run web -w expo-todo",
    "example:server": "node examples/dev-server.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "@types/react": "^19.0.0"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}